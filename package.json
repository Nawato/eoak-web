{
  "name": "eoak-web-root",
  "private": true,
  "scripts": {
    "dev:web": "npm --prefix web run dev",
    "dev:studio": "npm --prefix studio run dev",
    "build:web": "npm --prefix web run build",
    "test": "npm --prefix web run test",
    "test:web": "npm --prefix web run test",
    "lint": "npm --prefix web run lint",
    "typecheck": "npm --prefix web run typecheck",
    "verify": "npm run lint && npm run typecheck && npm run test && npm run build:web",
    "install:all": "npm --prefix web install && npm --prefix studio install"
  }
}
