# Environment Variables
# Copy this file to .env.local and fill in your values.

NEXT_PUBLIC_SANITY_PROJECT_ID="lru32awc"
NEXT_PUBLIC_SANITY_DATASET="production"
# Only needed for private datasets or draft access. Never commit it.
SANITY_API_READ_TOKEN=""

# Editor token (write access); only used by /go to count release link clicks. Never commit it.
SANITY_API_WRITE_TOKEN=""
# Independent random secret for HMAC-based daily IP deduplication (at least 32 characters).
RELEASE_CLICK_HASH_SECRET=""
# Set ONLY to a header your reverse proxy overwrites with the actual client IP.
# Used for unique-click counting and contact/newsletter rate limiting.
# Leave empty to disable per-visitor tracking/limits; never trust an arbitrary forwarded header.
RELEASE_CLICK_IP_HEADER=""
# Bearer secret for scheduled POST /api/release-clicks/cleanup (run daily).
RELEASE_CLICK_CLEANUP_SECRET=""
# Session secret for authorizing scheduled/admin API requests (at least 32 characters). If unset,
# falls back to RELEASE_CLICK_CLEANUP_SECRET so existing deployments keep working until rotated.
SESSION_SECRET=""

RESEND_API_KEY=""
# Recipient is Site Settings > Contact Email in Sanity (default: kontakt@endofallknown.de).
# Verified Resend sender address; visitors' addresses are used only for Reply-To.
CONTACT_FROM_EMAIL="kontakt@endofallknown.de"
# Resend Audience for newsletter double opt-in. The native form is used only when
# RESEND_API_KEY, RESEND_AUDIENCE_ID and a signing secret are all configured.
RESEND_AUDIENCE_ID=""
# Independent random secret for signing newsletter confirmation tokens (at least 32 characters).
# Falls back to SESSION_SECRET when empty. Never commit it.
NEWSLETTER_SIGNING_SECRET=""

# Public site URL, used for canonical URLs, sitemap and Open Graph. Required in production and
# must be an absolute HTTPS URL: the server refuses to fall back to localhost or send
# newsletter confirmation links over plaintext.
NEXT_PUBLIC_SITE_URL="https://endofallknown.de"
# Development only: comma-separated hostnames (no scheme or port) that may load dev
# assets/HMR when you open the dev server from another device or tunnel.
# Example: ALLOWED_DEV_ORIGINS="192.168.178.*,*.tunnel.example.com"
ALLOWED_DEV_ORIGINS=""
# Secret for the Sanity webhook that calls /api/revalidate
SANITY_REVALIDATE_SECRET=""

# Instagram API with Instagram Login (Business/Creator account).
# Server-only: generate a long-lived token in the Meta App Dashboard.
# Refresh/replace before its 60-day expiry; never use NEXT_PUBLIC_ for these.
INSTAGRAM_ACCESS_TOKEN=""
INSTAGRAM_USER_ID=""
