# Environment Variables
# Copy this file to .env.local and fill in your values.

NEXT_PUBLIC_SANITY_PROJECT_ID="lru32awc"
NEXT_PUBLIC_SANITY_DATASET="production"
# Only needed for private datasets or draft access. Never commit it.
SANITY_API_READ_TOKEN=""

RESEND_API_KEY=""
# Recipient is Site Settings > Contact Email in Sanity (default: kontakt@endofallknown.de).
# Verified Resend sender address; visitors' addresses are used only for Reply-To.
CONTACT_FROM_EMAIL="kontakt@endofallknown.de"

# Public site URL, used for canonical URLs, sitemap and Open Graph
NEXT_PUBLIC_SITE_URL="https://endofallknown.de"
# Secret for the Sanity webhook that calls /api/revalidate
SANITY_REVALIDATE_SECRET=""
